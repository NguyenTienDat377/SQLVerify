# ─────────────────────────────────────────────────────────────────────────
# Supabase (DB + auth)
# ─────────────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-api-key       # Dashboard → Settings → API → Publishable (formerly anon)
SUPABASE_SERVICE_KEY=your-secret-api-key         # Dashboard → Settings → API → Secret (formerly service_role) — server-side only
# Note: JWTs are verified against Supabase's public JWKS (no shared JWT secret needed here).

# Supabase dashboard config — NOT read by this app; set these in the Supabase dashboard
# (Authentication → Providers → GitHub). Listed here as a deploy reminder.
# Callback URL: http://localhost:8000/auth/callback (dev) | https://your-domain.com/auth/callback (prod)
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=your-github-client-id
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=your-github-client-secret

# ─────────────────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────────────────
SITE_URL=http://localhost:8000   # full origin, no trailing slash — auth redirects + CORS
LOG_LEVEL=INFO                   # optional — DEBUG | INFO | WARNING | ERROR
ENABLE_DOCS=true                 # optional — serve the Swagger console at /api-docs, /api-redoc,
                                 #   /openapi.json (leave unset in prod: it 404s them, which is the
                                 #   real access control). /docs is the public docs page, not this.
POSTHOG_API_KEY=                 # optional — unset disables analytics entirely (no-op)
POSTHOG_HOST=                    # optional — https://us.i.posthog.com (default) | https://eu.i.posthog.com

# ─────────────────────────────────────────────────────────────────────────
# LLM explainer (multi-provider — set the key for whichever EXPLAINER_PROVIDER you pick)
# ─────────────────────────────────────────────────────────────────────────
EXPLAINER_PROVIDER=claude        # claude | openai | google
ANTHROPIC_API_KEY=sk-ant-...     # required when EXPLAINER_PROVIDER=claude
OPENAI_API_KEY=                  # required when EXPLAINER_PROVIDER=openai
GEMINI_API_KEY=                  # required when EXPLAINER_PROVIDER=google
EXPLAINER_BREAKER_THRESHOLD=3    # optional — consecutive failures before the breaker opens
EXPLAINER_BREAKER_RESET_S=30     # optional — seconds the breaker stays open before half-open

# ─────────────────────────────────────────────────────────────────────────
# Billing (Lemon Squeezy — Merchant of Record)
# ─────────────────────────────────────────────────────────────────────────
LEMONSQUEEZY_WEBHOOK_SECRET=     # Settings → Webhooks (HMAC signing secret)
LEMONSQUEEZY_API_KEY=            # for the customer-portal lookup
LS_INDIVIDUAL_VARIANT_ID=        # numeric variant id (webhook → tier map)
LS_TEAM_VARIANT_ID=
LS_INDIVIDUAL_CHECKOUT_URL=      # the .../checkout/buy/<uuid> buy-link
LS_TEAM_CHECKOUT_URL=
FREE_TIER_MONTHLY_LIMIT=100      # optional — runs/month before upgrade required

# ─────────────────────────────────────────────────────────────────────────
# Error tracking (Sentry) — leave SENTRY_DSN blank to disable (no-op locally)
# ─────────────────────────────────────────────────────────────────────────
SENTRY_DSN=                      # Sentry project → Settings → Client Keys (DSN)
SENTRY_ENVIRONMENT=production     # production | staging | development
SENTRY_TRACES_SAMPLE_RATE=0.0    # 0.0 = errors only; raise for performance/APM

DISCORD_WEBHOOK_SIGNUPS = your #👤-signups webhook URL
DISCORD_WEBHOOK_REVENUE = your #💰-revenue webhook URL
