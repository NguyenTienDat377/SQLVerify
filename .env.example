SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-api-key       # Supabase dashboard → Settings → API → Publishable (formerly anon)
SUPABASE_SERVICE_KEY=your-secret-api-key          # Supabase dashboard → Settings → API → Secret (formerly service_role)
SUPABASE_JWT_SECRET=your-jwt-secret              # Supabase dashboard → Settings → API → JWT Secret

# GitHub OAuth — create at github.com/settings/developers → OAuth Apps
# Callback URL: http://localhost:8000/auth/callback (dev) | https://your-domain.com/auth/callback (prod)
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=your-github-client-id
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=your-github-client-secret

# Public URL of this app (used to build the OAuth callback URL)
SITE_URL=http://localhost:8000
LEMONSQUEEZY_WEBHOOK_SECRET=   
LS_INDIVIDUAL_VARIANT_ID=      
LS_TEAM_VARIANT_ID=            

SUPABASE_JWT_SECRET=your-jwt-secret
ANTHROPIC_API_KEY=sk-ant-...
EXPLAINER_PROVIDER=claude   # claude | openai | google
